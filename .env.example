DATABASE_URL=postgresql://inventory:local_password@127.0.0.1:5433/inventory
# Use the same value locally. In Neon, DATABASE_URL is pooled and DIRECT_URL is direct.
DIRECT_URL=postgresql://inventory:local_password@127.0.0.1:5433/inventory
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SUPER_ADMIN_USER_IDS=
# Preferred email provider.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Supplai <onboarding@resend.dev>"
# Optional fallback for a custom email service.
AUTH_EMAIL_WEBHOOK_URL=
# Optional: enables receipt extraction and inventory photo-count proposals.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
ENABLE_DEMO_MODE=false
DEMO_USER_EMAIL=maya.cohen@demo.supplai-pilot.com
DEMO_USER_PASSWORD=replace-with-a-demo-only-password
