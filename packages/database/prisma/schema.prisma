generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Criticality {
  HIGH
  MEDIUM
  LOW
}

enum MeasurementMode {
  UNIT
  PACKAGE
  WEIGHT
  VOLUME
  PERCENTAGE
  MANUAL
}

enum InventoryMovementType {
  RECEIPT
  EMERGENCY_PURCHASE
  MANUAL_ADDITION
  USAGE_ESTIMATE
  WASTE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  CORRECTION
}

model BusinessProfile {
  id           String              @id
  timezone     String              @default("Asia/Jerusalem")
  currency     String              @default("ILS")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  organization Organization        @relation(fields: [id], references: [id], onDelete: Cascade)
  locations    Location[]
  products     Product[]
  suppliers    Supplier[]
  movements    InventoryMovement[]
  auditEvents  AuditEvent[]
}

model User {
  id            String              @id
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false)
  image         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  role          String              @default("user")
  banned        Boolean             @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]        @relation("InvitationInviter")
  movements     InventoryMovement[]
  auditEvents   AuditEvent[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id              String           @id
  name            String
  slug            String           @unique
  logo            String?
  metadata        String?
  createdAt       DateTime
  businessProfile BusinessProfile?
  members         Member[]
  invitations     Invitation[]

  @@index([slug])
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("employee")
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Location {
  id           String              @id @default(cuid())
  businessId   String
  name         String
  address      String?
  active       Boolean             @default(true)
  business     BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storageAreas StorageArea[]
  movements    InventoryMovement[]

  @@index([businessId])
}

model StorageArea {
  id          String    @id @default(cuid())
  locationId  String
  name        String
  description String?
  active      Boolean   @default(true)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([locationId])
}

model Product {
  id                   String              @id @default(cuid())
  businessId           String
  name                 String
  barcode              String?
  category             String?
  measurementMode      MeasurementMode
  baseUnit             String
  primaryStorageAreaId String?
  minimumStock         Decimal?            @db.Decimal(12, 3)
  targetStock          Decimal?            @db.Decimal(12, 3)
  safetyStock          Decimal?            @db.Decimal(12, 3)
  shelfLifeDays        Int?
  criticality          Criticality         @default(MEDIUM)
  active               Boolean             @default(true)
  business             BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  primaryStorageArea   StorageArea?        @relation(fields: [primaryStorageAreaId], references: [id])
  supplierProducts     SupplierProduct[]
  movements            InventoryMovement[]

  @@index([businessId, active])
}

model Supplier {
  id                    String            @id @default(cuid())
  businessId            String
  name                  String
  orderDays             Int[]
  cutoffTime            String?
  deliveryLeadDays      Int               @default(1)
  minimumOrderValue     Decimal?          @db.Decimal(12, 2)
  minimumOrderUnits     Int?
  deliveryFee           Decimal?          @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal?          @db.Decimal(12, 2)
  currency              String            @default("ILS")
  active                Boolean           @default(true)
  business              BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products              SupplierProduct[]

  @@index([businessId, active])
}

model SupplierProduct {
  id                  String   @id @default(cuid())
  supplierId          String
  productId           String
  supplierSku         String?
  supplierDescription String?
  unitsPerPackage     Decimal  @db.Decimal(12, 3)
  packageSize         Decimal? @db.Decimal(12, 3)
  packageUnit         String?
  latestPackagePrice  Decimal? @db.Decimal(12, 2)
  isPreferred         Boolean  @default(false)
  priority            Int      @default(0)
  minimumPackages     Int?
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  businessId     String
  locationId     String
  productId      String
  type           InventoryMovementType
  quantityDelta  Decimal               @db.Decimal(12, 3)
  unit           String
  sourceType     String?
  sourceId       String?
  reason         String?
  occurredAt     DateTime              @default(now())
  createdById    String
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  business       BusinessProfile       @relation(fields: [businessId], references: [id])
  location       Location              @relation(fields: [locationId], references: [id])
  product        Product               @relation(fields: [productId], references: [id])
  createdBy      User                  @relation(fields: [createdById], references: [id])

  @@index([businessId, productId, occurredAt])
}

model AuditEvent {
  id         String          @id @default(cuid())
  businessId String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json
  occurredAt DateTime        @default(now())
  business   BusinessProfile @relation(fields: [businessId], references: [id])
  actor      User?           @relation(fields: [actorId], references: [id])

  @@index([businessId, occurredAt])
}
