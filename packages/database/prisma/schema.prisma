generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum Criticality {
  HIGH
  MEDIUM
  LOW
}

enum MeasurementMode {
  UNIT
  PACKAGE
  WEIGHT
  VOLUME
  PERCENTAGE
  MANUAL
}

enum InventoryMovementType {
  RECEIPT
  EMERGENCY_PURCHASE
  MANUAL_ADDITION
  USAGE_ESTIMATE
  WASTE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  CORRECTION
}

model Business {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Asia/Jerusalem")
  currency  String   @default("ILS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  locations Location[]
  users     User[]
  products  Product[]
  suppliers Supplier[]
  movements InventoryMovement[]
  auditEvents AuditEvent[]
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storageAreas StorageArea[]
  movements InventoryMovement[]
  @@index([businessId])
}

model User {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String   @unique
  role       UserRole @default(EMPLOYEE)
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  auditEvents AuditEvent[]
  @@index([businessId])
}

model StorageArea {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  description String?
  active      Boolean  @default(true)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products    Product[]
  @@index([locationId])
}

model Product {
  id                   String          @id @default(cuid())
  businessId           String
  name                 String
  barcode              String?
  category             String?
  measurementMode      MeasurementMode
  baseUnit             String
  primaryStorageAreaId String?
  minimumStock         Decimal?        @db.Decimal(12, 3)
  targetStock          Decimal?        @db.Decimal(12, 3)
  safetyStock          Decimal?        @db.Decimal(12, 3)
  shelfLifeDays        Int?
  criticality          Criticality     @default(MEDIUM)
  active               Boolean         @default(true)
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  primaryStorageArea   StorageArea?    @relation(fields: [primaryStorageAreaId], references: [id])
  supplierProducts     SupplierProduct[]
  movements            InventoryMovement[]
  @@index([businessId, active])
}

model Supplier {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  orderDays             Int[]
  cutoffTime             String?
  deliveryLeadDays      Int      @default(1)
  minimumOrderValue     Decimal? @db.Decimal(12, 2)
  minimumOrderUnits     Int?
  deliveryFee           Decimal? @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  currency              String   @default("ILS")
  active                Boolean  @default(true)
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products              SupplierProduct[]
  @@index([businessId, active])
}

model SupplierProduct {
  id                  String   @id @default(cuid())
  supplierId          String
  productId           String
  supplierSku         String?
  supplierDescription String?
  unitsPerPackage     Decimal  @db.Decimal(12, 3)
  packageSize         Decimal? @db.Decimal(12, 3)
  packageUnit         String?
  latestPackagePrice  Decimal? @db.Decimal(12, 2)
  isPreferred         Boolean  @default(false)
  priority            Int      @default(0)
  minimumPackages     Int?
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([supplierId, productId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  businessId     String
  locationId     String
  productId      String
  type           InventoryMovementType
  quantityDelta  Decimal               @db.Decimal(12, 3)
  unit           String
  sourceType     String?
  sourceId       String?
  reason         String?
  occurredAt     DateTime              @default(now())
  createdById    String
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  business       Business              @relation(fields: [businessId], references: [id])
  location       Location              @relation(fields: [locationId], references: [id])
  product        Product               @relation(fields: [productId], references: [id])
  createdBy      User                  @relation(fields: [createdById], references: [id])
  @@index([businessId, productId, occurredAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  businessId  String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    Json
  occurredAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  actor       User?    @relation(fields: [actorId], references: [id])
  @@index([businessId, occurredAt])
}
